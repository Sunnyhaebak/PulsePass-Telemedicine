// Prisma Schema for PostgreSQL
// Telemedicine & Patient Outpatient Consultation Platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PATIENT
  DOCTOR
  ADMIN
}

enum PassStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum SlotStatus {
  AVAILABLE
  LOCKED
  BOOKED
  COMPLETED
  CANCELLED
}

enum MessageType {
  TEXT
  REPORT_REF
  PRESCRIPTION_NOTE
  SYSTEM
}

enum ReportCategory {
  LAB_REPORT
  CARDIOLOGY_TRACE
  PRESCRIPTION
  RADIOLOGY
}

model Hospital {
  id        String   @id @default(uuid())
  name      String
  city      String
  state     String
  address   String
  createdAt DateTime @default(now()) @map("created_at")
  users     User[]

  @@map("hospitals")
}

model User {
  id           String          @id @default(uuid())
  fullName     String          @map("full_name")
  phone        String          @unique
  email        String          @unique
  passwordHash String          @map("password_hash")
  role         Role            @default(PATIENT)
  hospitalId   String?         @map("hospital_id")
  hospital     Hospital?       @relation(fields: [hospitalId], references: [id], onDelete: SetNull)
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  doctorProfile       DoctorProfile?
  patientPasses       ConsultationPass[] @relation("PatientPasses")
  patientSlots        TimeSlot[]         @relation("PatientSlots")
  patientReports      MedicalReport[]
  sentMessages        ChatMessage[]

  @@map("users")
}

model DoctorProfile {
  id                 String             @id @default(uuid())
  userId             String             @unique @map("user_id")
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialization     String
  registrationNumber String             @unique @map("registration_number")
  consultationFee    Int                @default(500) @map("consultation_fee") // in INR
  passDurationDays   Int                @default(7) @map("pass_duration_days")
  isVerified         Boolean            @default(false) @map("is_verified")
  createdAt          DateTime           @default(now()) @map("created_at")

  doctorPasses       ConsultationPass[] @relation("DoctorPasses")
  doctorSlots        TimeSlot[]         @relation("DoctorSlots")

  @@map("doctor_profiles")
}

model ConsultationPass {
  id             String        @id @default(uuid())
  patientId      String        @map("patient_id")
  patient        User          @relation("PatientPasses", fields: [patientId], references: [id], onDelete: Cascade)
  doctorId       String        @map("doctor_id")
  doctor         DoctorProfile @relation("DoctorPasses", fields: [doctorId], references: [id], onDelete: Cascade)
  paymentOrderId String        @unique @map("payment_order_id")
  amountPaid     Int           @map("amount_paid")
  currency       String        @default("INR")
  startsAt       DateTime      @default(now()) @map("starts_at")
  expiresAt      DateTime      @map("expires_at")
  status         PassStatus    @default(ACTIVE)
  createdAt      DateTime      @default(now()) @map("created_at")

  timeSlots      TimeSlot[]
  medicalReports MedicalReport[]
  chatMessages   ChatMessage[]

  @@index([patientId, status])
  @@index([doctorId, status])
  @@index([expiresAt])
  @@map("consultation_passes")
}

model TimeSlot {
  id         String            @id @default(uuid())
  doctorId   String            @map("doctor_id")
  doctor     DoctorProfile     @relation("DoctorSlots", fields: [doctorId], references: [id], onDelete: Cascade)
  patientId  String?           @map("patient_id")
  patient    User?             @relation("PatientSlots", fields: [patientId], references: [id], onDelete: SetNull)
  passId     String?           @map("pass_id")
  pass       ConsultationPass? @relation(fields: [passId], references: [id], onDelete: SetNull)
  startTime  DateTime          @map("start_time")
  endTime    DateTime          @map("end_time")
  status     SlotStatus        @default(AVAILABLE)
  turnNumber Int               @default(1) @map("turn_number")
  version    Int               @default(1) // Optimistic locking guard
  createdAt  DateTime          @default(now()) @map("created_at")
  updatedAt  DateTime          @updatedAt @map("updated_at")

  @@unique([doctorId, startTime])
  @@index([doctorId, status, startTime])
  @@map("time_slots")
}

model MedicalReport {
  id          String           @id @default(uuid())
  patientId   String           @map("patient_id")
  patient     User             @relation(fields: [patientId], references: [id], onDelete: Cascade)
  passId      String           @map("pass_id")
  pass        ConsultationPass @relation(fields: [passId], references: [id], onDelete: Cascade)
  fileName    String           @map("file_name")
  s3ObjectKey String           @unique @map("s3_object_key")
  mimeType    String           @map("mime_type")
  category    ReportCategory   @default(LAB_REPORT)
  summary     String?          @db.Text
  uploadedAt  DateTime         @default(now()) @map("uploaded_at")

  @@index([patientId, passId])
  @@map("medical_reports")
}

model ChatMessage {
  id          String           @id @default(uuid())
  passId      String           @map("pass_id")
  pass        ConsultationPass @relation(fields: [passId], references: [id], onDelete: Cascade)
  senderId    String           @map("sender_id")
  sender      User             @relation(fields: [senderId], references: [id], onDelete: Cascade)
  messageType MessageType      @default(TEXT) @map("message_type")
  content     String           @db.Text
  reportId    String?          @map("report_id")
  createdAt   DateTime         @default(now()) @map("created_at")

  @@index([passId, createdAt])
  @@map("chat_messages")
}

model AuditLog {
  id        String   @id @default(uuid())
  event     String
  role      String
  details   String   @db.Text
  timestamp DateTime @default(now())

  @@map("audit_logs")
}
